{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{% if page.cart %}
    {% set summary = page.cart %}
{% elseif page.order %}
    {% set summary = page.order %}
{% endif %}

{# Get currency and locale from sales channel context #}
{% set currency = context.currency.isoCode|default(app.request.get('sw-currency'))|default('EUR') %}
{% set localeCode = app.request.locale|default('en-GB') %}
{% set locale = localeCode|replace({'-':'_'}) %}

 {% block component_payment_method_image %}
  {% if 'handler_hipay_creditcard' in payment.formattedHandlerIdentifier %}
    {% sw_include '@HiPayPaymentPlugin/storefront/component/payment/creditcards/hipay-creditcard-image.html.twig' %}
  {% else %}
    {{ parent() }}
  {% endif %}
 {% endblock %}


{% block component_payment_method_description %}
  {% block component_payment_method_description_text %}
  {% endblock %}
  {{ parent() }}

  {% if payment.id is same as(selectedPaymentMethodId)
      and 'handler_hipay_' in payment.formattedHandlerIdentifier
      and activeRoute in ['frontend.account.edit-order.page', 'frontend.checkout.confirm.page']
  %}
    <div class="hipay-hosted-fields-wrapper">
    {% set environment = config('HiPayPaymentPlugin.config.environment') %}
    {% set env = environment|lower|default('stage') %}
    {% set componentName = payment.formattedHandlerIdentifier|replace({'_':'-'}) %}

    {% if config('HiPayPaymentPlugin.config.operationMode') == 'hostedFields' %}
      <script src={{config('HiPayPaymentPlugin.config.sdkjsUrl')}}></script>
      {% if componentName == 'handler-hipay-applepay'%}
        {% set hipayConfig = {
            username: config('HiPayPaymentPlugin.config.publicApplePayLogin' ~ environment),
            password: config('HiPayPaymentPlugin.config.publicApplePayPassword' ~ environment),
            merchantId: payment.customFields.merchantId,
            merchantName: payment.customFields.merchantName,
            shopname: page.metaInformation.metaTitle,
            environment: env,
            lang: localeCode|slice(0, 2),
            countryCode: localeCode|slice(3, 2),
            amount: summary.price.totalPrice,
            currency: currency,
            styles: {
              base: {
                color: config('HiPayPaymentPlugin.config.hostedFieldsTextColor'),
                fontSize: config('HiPayPaymentPlugin.config.hostedFieldsFontSize'),
                fontFamily: config('HiPayPaymentPlugin.config.hostedFieldsFontFamilly'),
                fontWeight: config('HiPayPaymentPlugin.config.hostedFieldsFontWeight'),
                placeholderColor: config('HiPayPaymentPlugin.config.hostedFieldsPlaceholderColor'),
                iconColor: config('HiPayPaymentPlugin.config.hostedFieldsIconColor'),
                caretColor: config('HiPayPaymentPlugin.config.hostedFieldsCaretColor')
              },
              buttonType: payment.customFields.buttonType,
              buttonStyle: payment.customFields.buttonStyle,
            }
          }
        %}
      {% elseif isPayPalV2Enabled %}
        {% set shippingAddress = null %}
        {% set addr = null %}

        {# For order context (order-pay page) - use deliveries #}
        {% if page.order is defined and summary.deliveries is defined and summary.deliveries|length > 0 %}
          {% set delivery = summary.deliveries.first %}
          {% if delivery.shippingOrderAddress is defined and delivery.shippingOrderAddress %}
            {% set addr = delivery.shippingOrderAddress %}
          {% endif %}
        {# For cart context (checkout confirm page) - use customer shipping address #}
        {% elseif page.cart is defined and context.shippingLocation is defined %}
          {% set addr = context.shippingLocation.address %}
        {% endif %}

        {# Build shipping address object if we have an address #}
        {% if addr %}
          {% set shippingAddress = {
            firstname: addr.firstName|default(''),
            lastname: addr.lastName|default(''),
            recipientinfo: addr.company|default(''),
            streetaddress: addr.street|default(''),
            streetaddress2: (addr.additionalAddressLine1|default('') ~ ' ' ~ addr.additionalAddressLine2|default(''))|trim,
            city: addr.city|default(''),
            zipcode: addr.zipcode|default(''),
            country: (addr.country and addr.country.iso) ? addr.country.iso : ''
          } %}
        {% endif %}
        {% set hipayConfig = {
          username: config('HiPayPaymentPlugin.config.publicLogin' ~ environment),
          password: config('HiPayPaymentPlugin.config.publicPassword' ~ environment),
          environment: env,
          canPayLater: payment.customFields.bnpl,
          amount: summary.price.totalPrice,
          currency: currency,
          lang: localeCode|slice(0, 2),
          locale: locale,
          shippingAddress: shippingAddress,
          translations: {
            'invalid-address': 'hipay.hosted-fields.paypal.invalid-address'|trans,
            'field-streetaddress': 'hipay.hosted-fields.paypal.field-streetaddress'|trans,
            'field-zipcode': 'hipay.hosted-fields.paypal.field-zipcode'|trans,
            'field-city': 'hipay.hosted-fields.paypal.field-city'|trans,
            'field-country': 'hipay.hosted-fields.paypal.field-country'|trans
          },
          styles: {
            color: payment.customFields.color|default('gold'),
            shape: payment.customFields.shape|default('pill'),
            label: payment.customFields.label|default('paypal'),
            height: payment.customFields.height|default('40')
          }
        }%}
      {% else %}
        {% set hipayConfig = {
            paymentProductName: payment.technicalName|replace({'hipay-':''}),
            username: config('HiPayPaymentPlugin.config.publicLogin' ~ environment),
            password: config('HiPayPaymentPlugin.config.publicPassword' ~ environment),
            environment: env,
            lang: localeCode|slice(0, 2),
            amount: summary.price.totalPrice,
            currency: currency,
            styles: {
              base: {
                color: config('HiPayPaymentPlugin.config.hostedFieldsTextColor'),
                fontSize: config('HiPayPaymentPlugin.config.hostedFieldsFontSize'),
                fontFamily: config('HiPayPaymentPlugin.config.hostedFieldsFontFamilly'),
                fontWeight: config('HiPayPaymentPlugin.config.hostedFieldsFontWeight'),
                placeholderColor: config('HiPayPaymentPlugin.config.hostedFieldsPlaceholderColor'),
                iconColor: config('HiPayPaymentPlugin.config.hostedFieldsIconColor'),
                caretColor: config('HiPayPaymentPlugin.config.hostedFieldsCaretColor')
              }
            }
          }
        %}
      {% endif %}
      {% block hipay_hosted_fields_html %}
        <input type="text"
          name="hipay-response"
          id="hipay-response"
          form="confirmOrderForm"
          style="position: absolute; visibility: hidden;"
          required
        />
      {% endblock %}
      {% if payment.extensions.hipayConfig.haveHostedFields or isPayPalV2Enabled %}
        {% sw_include '@HiPayPaymentPlugin/storefront/component/payment/hosted-fields/' ~ componentName ~ '.html.twig' %}
      {% else %}
        {% sw_include '@HiPayPaymentPlugin/storefront/component/payment/hosted-fields/handler-hipay-default.html.twig' %}
      {% endif %}

    {% elseif payment.formattedHandlerIdentifier != 'handler_hipay_multibanco' || config('HiPayPaymentPlugin.config.operationMode') != 'hostedFields'
    %}
      <p>{{ 'hipay.hosted-page.redirect-message'|trans }}</p>
    {% endif %}
    </div>
  {% endif %}

  {% if 'handler_hipay_creditcard' in payment.formattedHandlerIdentifier
      and activeRoute in ['frontend.account.payment.page']
      and page.extensions.card_tokens
  %}
    {% sw_include '@HiPayPaymentPlugin/storefront/component/payment/creditcards/account-creditcard.html.twig' %}
  {% endif %}

{% endblock %}
